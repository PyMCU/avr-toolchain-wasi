# Sources and SDKs: downloaded by the build scripts.
binutils-2.42/
binutils-2.42.tar.xz
wasi-sdk
wasi-sdk-*/
wasi-sdk.tar.gz
build/
native/

# Build products: CI produces these, they do not belong in history.
*.wasm
dist/
dist-*/
wheel*/dist/
wheel*/build/
sysroot-min/
sysroot-ffi/

