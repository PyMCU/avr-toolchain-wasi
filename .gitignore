.cwasm*/

# Test corpus and scratch.
t/
verify-bundle/
verify-bundle-ffi/
__pycache__/
*.log

# Wheel payload: copied in by the build, not source.
wheel*/src/*/include/
wheel*/src/*/wasm/
wheel*/src/*/sysroot/
